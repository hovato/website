---
import { Picture, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import MapKochi from "../../components/MapKochi.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
import Marquee from "../../components/Marquee.astro";
import { stays, type Stay } from "../../data/stays";
import { site } from "../../data/site";
import { stayJsonLd } from "../../data/seo";

export function getStaticPaths() {
  return stays.map((stay) => ({ params: { slug: stay.slug }, props: { stay } }));
}

interface Props {
  stay: Stay;
}
const { stay } = Astro.props;
const origin = (Astro.site ?? Astro.url).origin;
const others = stays.filter((s) => s.slug !== stay.slug);

// Large versions for the lightbox
const gallery = await Promise.all(
  stay.gallery.map(async (photo) => ({
    ...photo,
    full: (await getImage({ src: photo.src, width: 2000, format: "webp", quality: 80 })).src,
  })),
);

// Bento layout on a 12-column grid, as [column span, row span]. Full sets of eight
// repeat the main pattern; any leftover photos get a tail that still fills its rows.
const fullSet: [number, number][] = [[7, 2], [5, 1], [5, 1], [4, 1], [4, 1], [4, 1], [6, 1], [6, 1]];
const tails: Record<number, [number, number][]> = {
  0: [],
  1: [[12, 1]],
  2: [[6, 1], [6, 1]],
  3: [[7, 2], [5, 1], [5, 1]],
  4: [[7, 2], [5, 1], [5, 1], [12, 1]],
  5: [[7, 2], [5, 1], [5, 1], [6, 1], [6, 1]],
  6: [[7, 2], [5, 1], [5, 1], [4, 1], [4, 1], [4, 1]],
  7: [[7, 2], [5, 1], [5, 1], [4, 1], [4, 1], [4, 1], [12, 1]],
};
const layout: [number, number][] = [
  ...Array.from({ length: Math.floor(gallery.length / 8) }, () => fullSet).flat(),
  ...tails[gallery.length % 8],
];

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(stay.location.mapsQuery)}`;
const unitWord = stay.unit.count === 1 ? stay.unit.singular : stay.unit.plural;
---

<Base
  title={`${stay.name} · ${stay.kind}, ${stay.locality}, Kochi | Hovato`}
  description={stay.summary}
  ogImage={`/og/${stay.slug}.jpg`}
  headerTheme="light"
  theme={stay.theme}
  dock={{ staySlug: stay.slug, label: "Check dates" }}
  jsonLd={stayJsonLd(origin, stay)}
>
  <!-- Hero -->
  <section class="stay-hero" data-hero aria-labelledby="stay-title">
    <div class="stay-hero__media" data-hero-media>
      <div class="stay-hero__img" style={`view-transition-name: stay-${stay.slug}`} data-hero-scroll>
        <Picture
          src={stay.hero.src}
          alt={stay.hero.alt}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          formats={["avif", "webp"]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="stay-hero__shade"></div>

    <div class="wrap stay-hero__content">
      <nav class="crumbs" aria-label="Breadcrumb" data-hero-in>
        <a href="/">Hovato</a>
        <span aria-hidden="true">/</span>
        <a href="/#stays">Stays</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{stay.name}</span>
      </nav>
      <p class="eyebrow eyebrow--rule stay-hero__eyebrow" data-hero-in>{stay.index} · {stay.kind}</p>
      <h1 class="display-xl stay-hero__title" id="stay-title">
        <span class="split-line"><span data-hero-line>{stay.nameLines[0]}</span></span>
        <span class="split-line"><span data-hero-line><em>{stay.nameLines[1]}</em></span></span>
      </h1>
      <div class="stay-hero__foot" data-hero-in>
        <p class="stay-hero__tagline">
          <Icon name="map-pin" size={16} />
          {stay.area}
        </p>
        <dl class="stay-hero__facts">
          {
            stay.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd class="serif">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Floating booking bar -->
  <div class="staybar" data-staybar aria-label={`Book ${stay.name}`} role="region">
    <div class="staybar__thumb frame">
      <Picture src={stay.hero.src} alt="" widths={[120, 180]} sizes="56px" formats={["avif", "webp"]} loading="lazy" />
    </div>
    <div class="staybar__name">
      <strong class="serif">{stay.name}</strong>
      <span>{stay.inventory}</span>
    </div>
    <button class="staybar__field" type="button" data-book-open="dates" data-book-stay={stay.slug}>
      <small>Dates</small>
      <span data-book-value="dates">Add dates</span>
    </button>
    <button class="staybar__field" type="button" data-book-open="dates" data-book-stay={stay.slug}>
      <small>Guests</small>
      <span data-book-value="guests">2 adults</span>
    </button>
    <Button variant="brass" size="sm" icon="arrow-right" data-book-open="auto" data-book-stay={stay.slug}>Check availability</Button>
  </div>

  <!-- Intro -->
  <section class="stay-intro section" aria-labelledby="stay-intro-title">
    <div class="wrap stay-intro__grid">
      <div>
        <p class="eyebrow eyebrow--rule stay-accent-text" data-reveal>The stay</p>
        <h2 class="h2 stay-intro__title" id="stay-intro-title" data-split>{stay.intro.heading}</h2>
      </div>
      <div class="stay-intro__body">
        {
          stay.intro.body.map((p, i) => (
            <p class:list={[i === 0 ? "lede" : "muted"]} data-reveal>
              {p}
            </p>
          ))
        }
        <div class="stay-intro__best" data-reveal>
          <span class="stay-intro__best-label">Best for</span>
          <ul role="list">
            {stay.bestFor.map((b) => <li class="chip">{b}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="wrap stay-intro__pair">
      <div class="stay-intro__big frame frame--round" data-img-reveal>
        <Picture src={gallery[0].src} alt={gallery[0].alt} widths={[640, 960, 1400]} sizes="(min-width: 900px) 58vw, 92vw" formats={["avif", "webp"]} loading="lazy" data-parallax="0.1" />
      </div>
      <div class="stay-intro__small">
        <div class="frame frame--arch" data-img-reveal>
          <Picture src={gallery[1].src} alt={gallery[1].alt} widths={[400, 640, 900]} sizes="(min-width: 900px) 28vw, 70vw" formats={["avif", "webp"]} loading="lazy" data-parallax="0.12" />
        </div>
        <p class="stay-intro__caption serif" data-reveal>{stay.tagline}</p>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="highlights section" aria-labelledby="highlights-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow eyebrow--rule" data-reveal>Why guests choose it</p>
          <h2 class="h2" id="highlights-title" data-split>The good <em>bits.</em></h2>
        </div>
        <p class="muted" data-reveal>{stay.summary}</p>
      </div>
      <ul class="highlights__list" role="list" data-reveal-stagger>
        {
          stay.highlights.map((h, i) => (
            <li class="highlight">
              <span class="highlight__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="highlight__icon">
                <Icon name={h.icon} size={28} stroke={1.25} />
              </span>
              <h3 class="h4">{h.title}</h3>
              <p class="muted">{h.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Gallery -->
  <section class="gallery-sec section" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow eyebrow--rule" data-reveal>Take a look around</p>
          <h2 class="h2" id="gallery-title" data-split>Inside <em>{stay.shortName}.</em></h2>
        </div>
        <p class="muted" data-reveal>Tap any photo to see it full screen.</p>
      </div>
      <div class="gallery" data-reveal-stagger>
        {
          gallery.map((g, i) => (
            <button
              type="button"
              class="gallery__item frame"
              style={`--c:${layout[i]?.[0] ?? 4};--r:${layout[i]?.[1] ?? 1}`}
              data-gallery-item
              data-full={g.full}
              data-caption={g.alt}
              data-cursor-label="View"
              aria-label={`View photo: ${g.alt}`}
            >
              <Picture
                src={g.src}
                alt={g.alt}
                widths={[480, 800, 1200]}
                sizes={(layout[i]?.[0] ?? 4) >= 7 ? "(min-width: 900px) 58vw, 92vw" : "(min-width: 900px) 34vw, 92vw"}
                formats={["avif", "webp"]}
                loading="lazy"
              />
              <span class="gallery__zoom" aria-hidden="true">
                <Icon name="maximize-2" size={16} />
              </span>
            </button>
          ))
        }
      </div>
      <p class="gallery__note small muted">Photos are for illustration while the property shoot is being completed.</p>
    </div>
  </section>

  <!-- Amenities -->
  <section class="amenities section section--paper" aria-labelledby="amenities-title">
    <div class="wrap amenities__grid">
      <div>
        <p class="eyebrow eyebrow--rule" data-reveal>In every {stay.unit.singular}</p>
        <h2 class="h2" id="amenities-title" data-split>Everything <em>you'll need.</em></h2>
        <p class="muted amenities__intro" data-reveal>
          {stay.inventory}, looked after to the Hovato standard. Ask us if there's something you'd like waiting on arrival.
        </p>
      </div>
      <ul class="amenities__list" role="list" data-reveal-stagger>
        {
          stay.amenities.map((a) => (
            <li>
              <span class="amenities__icon">
                <Icon name={a.icon} size={22} stroke={1.4} />
              </span>
              {a.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Location -->
  <section class="location section" aria-labelledby="location-title">
    <div class="wrap location__grid">
      <div class="location__map" data-reveal>
        <MapKochi focus={stay.slug} />
      </div>
      <div class="location__text">
        <p class="eyebrow eyebrow--rule" data-reveal>Location</p>
        <h2 class="h2" id="location-title" data-split>{stay.location.heading[0]} <em>{stay.location.heading[1]}</em></h2>
        <p class="muted location__intro" data-reveal>
          {stay.location.intro}
        </p>
        <ul class="location__list" role="list" data-reveal-stagger>
          {
            stay.nearby.map((n) => (
              <li>
                <span>{n.place}</span>
                <span class="location__time">{n.time}</span>
              </li>
            ))
          }
        </ul>
        <p class="small muted location__note">Approximate drive times. Traffic in Kochi can vary a lot.</p>
        <div data-reveal>
          <Button href={mapsHref} variant="ghost" icon="arrow-up-right" target="_blank" rel="noopener">Open in Google Maps</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Good to know -->
  <section class="know" aria-label="Good to know">
    <div class="wrap">
      <ul class="know__list" role="list" data-reveal-stagger>
        <li>
          <Icon name="clock" size={22} />
          <span><small>Check-in</small>From {site.policies.checkIn}</span>
        </li>
        <li>
          <Icon name="clock" size={22} />
          <span><small>Check-out</small>By {site.policies.checkOut}</span>
        </li>
        <li>
          <Icon name="key-round" size={22} />
          <span><small>{stay.unit.count === 1 ? "The apartment" : `${stay.unit.count} ${unitWord}`}</small>{stay.unit.count === 1 ? "Booked privately" : "Book one or several"}</span>
        </li>
        <li>
          <Icon name="plane" size={22} />
          <span><small>Airport pickup</small>On request</span>
        </li>
      </ul>
    </div>
  </section>

  <Faq items={stay.faqs} id="stay-faq" />

  <Marquee words={[stay.name, stay.locality, "Kochi", "Kerala"]} />

  <!-- Other stays -->
  <section class="others section" aria-labelledby="others-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow eyebrow--rule" data-reveal>Also by Hovato</p>
          <h2 class="h2" id="others-title" data-split>Other ways <em>to stay.</em></h2>
        </div>
      </div>
      <div class="others__grid">
        {
          others.map((o) => (
            <a class="other" href={`/stays/${o.slug}/`} style={`--accent:${o.theme.accent}`} data-reveal>
              <div class="other__img frame frame--arch" style={`view-transition-name: stay-${o.slug}`} data-cursor-label="Explore">
                <Picture src={o.hero.src} alt="" widths={[480, 800, 1100]} sizes="(min-width: 900px) 40vw, 92vw" formats={["avif", "webp"]} loading="lazy" />
              </div>
              <div class="other__meta">
                <span class="other__kind">
                  {o.index} · {o.kind}
                </span>
                <h3 class="h3">{o.name}</h3>
                <p class="muted">
                  {o.inventory} · {o.area}
                </p>
                <span class="link link--under other__go">
                  Step inside <Icon name="arrow-right" size={16} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand staySlug={stay.slug} eyebrow={`Book ${stay.name} direct`} />

  <!-- Lightbox -->
  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <div class="lightbox__stage" data-lightbox-stage>
      <img data-lightbox-img alt="" />
    </div>
    <div class="lightbox__bar">
      <span class="lightbox__count tabular" data-lightbox-count></span>
      <p class="lightbox__caption" data-lightbox-caption></p>
      <div class="lightbox__nav">
        <button type="button" data-lightbox-prev aria-label="Previous photo"><Icon name="arrow-left" size={20} /></button>
        <button type="button" data-lightbox-next aria-label="Next photo"><Icon name="arrow-right" size={20} /></button>
      </div>
    </div>
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close photo viewer"><Icon name="x" size={22} /></button>
  </dialog>
</Base>

<style>
  .stay-accent-text {
    color: var(--accent);
  }

  /* Hero */
  .stay-hero {
    position: relative;
    min-height: max(100svh, 640px);
    display: flex;
    align-items: flex-end;
    color: var(--on-dark);
    background: var(--accent-deep);
    overflow: hidden;
    isolation: isolate;
  }
  .stay-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .stay-hero__img {
    position: absolute;
    inset: 0;
  }
  .stay-hero__img :global(picture) {
    height: 100%;
  }
  .stay-hero__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stay-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(26 21 18 / 0.5) 0%, rgb(26 21 18 / 0) 28%),
      linear-gradient(0deg, rgb(26 21 18 / 0.85) 0%, rgb(26 21 18 / 0.3) 45%, rgb(26 21 18 / 0) 70%);
  }
  .stay-hero__content {
    padding-top: calc(var(--header-h) + 4rem);
    padding-bottom: clamp(1.75rem, 5vh, 3.5rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(242 236 227 / 0.75);
    margin-bottom: 1.5rem;
  }
  .crumbs a:hover {
    color: var(--cream);
  }
  .crumbs [aria-current] {
    color: var(--cream);
  }
  .stay-hero__eyebrow {
    color: rgb(242 236 227 / 0.85);
    margin-bottom: 1.25rem;
  }
  .stay-hero__title {
    margin-bottom: clamp(1.75rem, 4vh, 3rem);
  }
  .stay-hero__title em {
    color: #e9d6b8;
  }
  .stay-hero__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(242 236 227 / 0.25);
  }
  .stay-hero__tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .stay-hero__facts {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .stay-hero__facts dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 236 227 / 0.7);
  }
  .stay-hero__facts dd {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
    line-height: 1.1;
  }

  /* Floating booking bar */
  .staybar {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: 700;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.45rem 0.45rem 0.45rem;
    border-radius: 999px;
    background: rgb(26 21 18 / 0.9);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    color: var(--cream);
    box-shadow: 0 24px 60px -20px rgb(26 21 18 / 0.6);
    transform: translate(-50%, 180%);
    transition: transform 0.8s var(--ease-out);
    max-width: calc(100% - 2rem);
  }
  .staybar:global(.is-visible) {
    transform: translate(-50%, 0);
  }
  :global(html.book-open) .staybar,
  :global(html.lightbox-open) .staybar {
    transform: translate(-50%, 180%);
  }
  .staybar__thumb {
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    flex: none;
  }
  .staybar__name {
    display: grid;
    line-height: 1.2;
    padding: 0 1.2rem 0 0.5rem;
    border-right: 1px solid rgb(242 236 227 / 0.18);
  }
  .staybar__name strong {
    font-size: 1.25rem;
    font-weight: 400;
  }
  .staybar__name span {
    font-size: 0.74rem;
    color: var(--on-dark-muted);
  }
  .staybar__field {
    display: grid;
    text-align: left;
    line-height: 1.25;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    transition: background-color 0.3s;
  }
  .staybar__field:hover {
    background: rgb(242 236 227 / 0.1);
  }
  .staybar__field small {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .staybar__field span {
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .staybar {
      display: none;
    }
  }

  /* Intro */
  .stay-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
  }
  .stay-intro__title {
    margin-top: 1.25rem;
    max-width: 14ch;
  }
  .stay-intro__body {
    display: grid;
    gap: 1.25rem;
    max-width: 52ch;
  }
  .stay-intro__best {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .stay-intro__best-label {
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .stay-intro__best ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stay-intro__pair {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .stay-intro__big {
    aspect-ratio: 16 / 11;
  }
  .stay-intro__small {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 12%;
  }
  .stay-intro__small .frame {
    aspect-ratio: 3 / 4;
  }
  .stay-intro__caption {
    font-size: 1.5rem;
    line-height: 1.2;
    font-style: italic;
    color: var(--ink-3);
  }

  /* Highlights */
  .highlights {
    background: var(--accent-tint);
  }
  .highlights__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .highlight {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 2rem 1.75rem 2.25rem;
    border-radius: var(--radius-l);
    background: rgb(255 255 255 / 0.45);
    box-shadow: inset 0 0 0 1px rgb(26 21 18 / 0.06);
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.4s;
  }
  .highlight:hover {
    transform: translateY(-6px);
    background: rgb(255 255 255 / 0.75);
  }
  .highlight__num {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--stone);
  }
  .highlight__icon {
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--cream);
    margin-bottom: 1rem;
  }
  .highlight p {
    font-size: 0.95rem;
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(180px, 19vw, 300px);
    gap: clamp(0.6rem, 1.2vw, 1.1rem);
  }
  .gallery__item {
    grid-column: span var(--c);
    grid-row: span var(--r);
    border-radius: var(--radius-m);
    cursor: zoom-in;
  }
  .gallery__item :global(picture) {
    height: 100%;
  }
  .gallery__item :global(img) {
    transition: transform 1.2s var(--ease-out);
  }
