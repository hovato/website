---
import { stays } from "../data/stays";

interface Props {
  words?: string[];
  tone?: "light" | "dark";
}
const {
  words = [...new Set([...stays.map((s) => s.locality), "Periyar", "Fort Kochi", "Kerala", "Kochi"])],
  tone = "light",
} = Astro.props;
---

<div class:list={["marquee", `marquee--${tone}`]} aria-hidden="true" data-marquee>
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {words.map((w, i) => (
            <>
              <span class:list={["marquee__word serif", { "marquee__word--outline": i % 2 === 1 }]}>{w}</span>
              <svg class="marquee__mark" viewBox="0 0 40 48">
                <path d="M9 45V20a11 11 0 0 1 22 0v25" />
                <path d="M3 45.5h34" />
                <circle cx="20" cy="24" r="2" />
              </svg>
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(1.5rem, 3vw, 2.75rem);
    border-block: 1px solid var(--line);
    user-select: none;
  }
  .marquee--dark {
    background: var(--ink);
    color: var(--on-dark);
    border-color: var(--line-dark);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__group {
    display: flex;
    align-items: center;
    flex: none;
  }
  .marquee__word {
    font-size: clamp(3rem, 2rem + 5vw, 7.5rem);
    line-height: 1;
    padding-inline: clamp(1.25rem, 2.5vw, 2.5rem);
    white-space: nowrap;
    font-style: italic;
  }
  .marquee__word--outline {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1px currentColor;
  }
  .marquee--light .marquee__word--outline {
    -webkit-text-stroke-color: var(--ink);
  }
  .marquee__mark {
    width: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
    flex: none;
    overflow: visible;
    color: var(--brass);
  }
  .marquee__mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .marquee__mark circle {
    fill: currentColor;
  }
</style>
