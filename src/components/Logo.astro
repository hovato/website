---
// Hovato mark: an arched doorway on its threshold, with the lamp left on.
interface Props {
  class?: string;
  /** Hide the wordmark and show only the arch. */
  markOnly?: boolean;
}
const { class: className, markOnly = false } = Astro.props;
---

<span class:list={["logo", className]}>
  <svg class="logo__mark" viewBox="0 0 40 48" aria-hidden="true" focusable="false">
    <path d="M9 45V20a11 11 0 0 1 22 0v25" />
    <path d="M3 45.5h34" />
    <circle cx="20" cy="24" r="2" />
  </svg>
  {!markOnly && <span class="logo__word">Hovato</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: inherit;
    line-height: 1;
  }
  .logo__mark {
    width: 1.55em;
    height: auto;
    flex: none;
    overflow: visible;
  }
  .logo__mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .logo__mark circle {
    fill: currentColor;
  }
  .logo__word {
    font-family: var(--font-display);
    font-size: 1.45em;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-right: -0.3em;
    translate: 0 0.04em;
  }
</style>
