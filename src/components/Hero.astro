---
import { Picture } from "astro:assets";
import BookBar from "./BookBar.astro";
import { heroSlides } from "../data/home";

const total = String(heroSlides.length).padStart(2, "0");
---

<section class="hero" data-hero aria-label="Welcome to Hovato">
  <div class="hero__media" data-hero-media>
    {
      heroSlides.map((s, i) => (
        <figure class:list={["hero__slide", { "is-active": i === 0 }]} data-hero-slide data-caption={s.caption}>
          <Picture
            src={s.src}
            alt={s.alt}
            widths={[768, 1280, 1920, 2560]}
            sizes="100vw"
            formats={["avif", "webp"]}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            style={s.position ? `object-position:${s.position}` : undefined}
          />
        </figure>
      ))
    }
    <div class="hero__shade"></div>
  </div>

  <div class="hero__content wrap">
    <p class="eyebrow eyebrow--rule hero__eyebrow" data-hero-in>Bespoke hospitality · Kochi, Kerala</p>
    <h1 class="display-xl hero__title">
      <span class="split-line"><span data-hero-line>Where better stays</span></span>
      <span class="split-line"><span data-hero-line>create <em>greater value.</em></span></span>
    </h1>
    <div class="hero__row">
      <p class="hero__lede" data-hero-in>
        Two-bedroom apartments in Manjummal, easy rooms and a private service apartment by Cochin International
        Airport. Three stays, one standard of care.
      </p>
      <div class="hero__counter" data-hero-in aria-hidden="true">
        <span class="hero__num tabular"><span data-hero-index>01</span> / {total}</span>
        <span class="hero__progress"><i data-hero-progress></i></span>
        <span class="hero__caption" data-hero-caption>{heroSlides[0].caption}</span>
      </div>
    </div>
    <div data-hero-in class="hero__book">
      <BookBar />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 680px);
    display: flex;
    align-items: flex-end;
    color: var(--on-dark);
    background: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.6s var(--ease-in-out);
  }
  .hero__slide :global(picture) {
    height: 100%;
  }
  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transform-origin: 50% 60%;
  }
  /* The incoming slide fades in above the outgoing one, which stays put underneath. */
  .hero__slide:global(.is-active) {
    opacity: 1;
    z-index: 2;
  }
  .hero__slide:global(.was-active) {
    opacity: 1;
    z-index: 1;
    transition: none;
  }
  .hero__slide:global(.is-active) :global(img),
  .hero__slide:global(.was-active) :global(img) {
    animation: kenburns 9s linear both;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(180deg, rgb(26 21 18 / 0.55) 0%, rgb(26 21 18 / 0) 26%),
      linear-gradient(0deg, rgb(26 21 18 / 0.82) 0%, rgb(26 21 18 / 0.35) 38%, rgb(26 21 18 / 0) 62%);
  }
  .hero__content {
    position: relative;
    z-index: 4;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .hero__eyebrow {
    color: rgb(242 236 227 / 0.85);
    margin-bottom: clamp(1rem, 2vh, 1.6rem);
  }
  .hero__title {
    font-size: clamp(3.1rem, 0.6rem + 7.2vw, 9rem);
    margin-bottom: clamp(1.25rem, 3vh, 2.4rem);
  }
  @media (min-width: 761px) {
    .hero__title .split-line {
      white-space: nowrap;
    }
  }
  .hero__title em {
    color: #e9d6b8;
  }
  .hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }
  .hero__lede {
    max-width: 44ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.18rem);
    line-height: 1.6;
    color: rgb(242 236 227 / 0.88);
  }
  .hero__counter {
    display: grid;
    grid-template-columns: auto 120px;
    align-items: center;
    gap: 0.4rem 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    flex: none;
  }
  .hero__progress {
    position: relative;
    height: 1px;
    background: rgb(242 236 227 / 0.3);
    overflow: hidden;
  }
  .hero__progress i {
    position: absolute;
    inset: 0;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__caption {
    grid-column: 1 / -1;
    justify-self: end;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: none;
    color: rgb(242 236 227 / 0.75);
  }
  @media (max-width: 760px) {
    .hero__counter {
      display: none;
    }
    .hero__content {
      padding-bottom: 1.25rem;
    }
  }
</style>
