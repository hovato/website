---
import { Picture } from "astro:assets";
import { totalKeys } from "../data/stays";
import heritageDoor from "../assets/images/heritage-door.jpg";
import kanikonna from "../assets/images/kanikonna.jpg";

const stats = [
  { value: 3, label: "Stays, each with its own character" },
  { value: totalKeys, label: "Apartments & rooms across Kochi" },
  { value: 2, label: "Neighbourhoods: Manjummal & the airport" },
  { value: 1, label: "Standard of care, everywhere" },
];
---

<section class="manifesto section" id="welcome" aria-labelledby="welcome-title">
  <div class="wrap manifesto__grid">
    <div class="manifesto__label">
      <p class="eyebrow eyebrow--rule" data-reveal id="welcome-title">Welcome to Hovato</p>
    </div>

    <p class="manifesto__text serif" data-scrub-text>
      Hovato is a small family of stays in Kochi. Each one has its own character, and all are kept to one quiet
      standard: <em>spotless rooms, honest prices</em> and a host who actually picks up the phone.
    </p>

    <div class="manifesto__art" aria-hidden="true">
      <div class="manifesto__door frame frame--arch" data-img-reveal>
        <Picture src={heritageDoor} alt="" widths={[360, 540, 720]} sizes="(min-width: 900px) 18vw, 40vw" formats={["avif", "webp"]} loading="lazy" data-parallax="0.08" />
      </div>
      <div class="manifesto__flower frame" data-img-reveal>
        <Picture src={kanikonna} alt="" widths={[240, 360]} sizes="12vw" formats={["avif", "webp"]} loading="lazy" />
      </div>
    </div>
  </div>

  <dl class="wrap stats" data-reveal-stagger>
    {
      stats.map((s) => (
        <div class="stat">
          <dt class="stat__label">{s.label}</dt>
          <dd class="stat__num serif" data-count={s.value}>
            {String(s.value).padStart(2, "0")}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .manifesto {
    padding-bottom: calc(var(--section) * 0.75);
  }
  .manifesto__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: start;
  }
  .manifesto__label {
    padding-top: 0.9rem;
  }
  .manifesto__text {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 4.1rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .manifesto__text em {
    color: var(--brass-text);
  }
  .manifesto__art {
    position: relative;
    padding-bottom: 3rem;
  }
  .manifesto__door {
    aspect-ratio: 3 / 4.4;
  }
  .manifesto__flower {
    position: absolute;
    left: -28%;
    bottom: 0;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
    outline: 6px solid var(--cream);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(4rem, 8vw, 8rem);
    border-top: 1px solid var(--line-strong);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 2rem 1.5rem 0 0;
  }
  .stat + .stat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .stat__num {
    font-size: clamp(3.6rem, 2.5rem + 4vw, 7rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    max-width: 22ch;
    font-size: 0.9rem;
    color: var(--stone);
  }

  @media (max-width: 1000px) {
    .manifesto__grid {
      grid-template-columns: 1fr 1fr;
    }
    .manifesto__label {
      grid-column: 1 / -1;
    }
    .manifesto__text {
      grid-column: 1 / -1;
    }
    .manifesto__art {
      grid-column: 2;
      max-width: 300px;
      justify-self: end;
      width: 100%;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 2rem;
    }
  }
  @media (max-width: 560px) {
    .manifesto__art {
      grid-column: 1 / -1;
      max-width: 240px;
    }
    .manifesto__flower {
      left: -34%;
    }
  }
</style>
